{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecCorp",
  "version": "1.0.5",
  "identifier": "com.webnetkz.seccom",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SecCorp",
        "backgroundColor": "#060a13",
        "dataDirectory": "SecCorp-WebView2-1.0.5"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../signatures/base/": "databases/bundled/"
    },
    "publisher": "webnetkz",
    "copyright": "© 2026 webnetkz",
    "category": "Utility",
    "shortDescription": "SecCorp Antivirus",
    "longDescription": "SecCorp protects your device: signature and heuristic scanning, real-time protection, encrypted quarantine and signed database updates.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
